<h1>New Profile</h1>

<%= form_with model: @profile, local: true do |form| %>
  <div>
    <%= form.label :username %>
    <%= form.text_field :username %>
  </div>

  <div>
    <%= form.label :interests %>
    <%= form.text_area :interests %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.text_field :status %>
  </div>

  <div>
    <%= form.submit 'Create Profile' %>
  </div>
<% end %>

<%= link_to 'Back to Profiles', profiles_path %>
